# ================================================================
#  VARIABLES DE ENTORNO — copia este archivo como  .env.local
#  y pega los valores de tu proyecto de Supabase.
#
#  Dónde encontrarlos en Supabase:
#   Project Settings  →  Data API  → Project URL  y  anon/public key
#   Project Settings  →  API Keys   → service_role key (¡SECRETA!)
#
#  IMPORTANTE: la URL es solo el dominio del proyecto,
#  por ejemplo  https://xxxxxxxx.supabase.co  (SIN /rest/v1/ al final).
# ================================================================

# URL del proyecto (ej: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon) — puede ir en el navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta (service_role) — SOLO en el servidor, NUNCA la compartas
SUPABASE_SERVICE_ROLE_KEY=
